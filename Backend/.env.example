# ---------------------------------------------------------------------------
# AnalyzeFlow backend - environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

APP_NAME=AnalyzeFlow API
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database -------------------------------------------------------------
# Async driver (used by the app)
DATABASE_URL=postgresql+asyncpg://analyzeflow:analyzeflow@localhost:5432/analyzeflow

# --- Security -------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS -----------------------------------------------------------------
# Comma-separated. Must include the GitHub Pages origin for the live front end.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://adamaliali.github.io

# --- Website scraper ------------------------------------------------------
SCRAPER_USER_AGENT=AnalyzeFlowBot/1.0 (+https://github.com/AdamAliAli/AnalyzeFlow)
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_BYTES=3000000
SCRAPER_MAX_REDIRECTS=5
SCRAPER_ALLOW_PRIVATE_HOSTS=false   # true ONLY for local testing against 127.0.0.1

# --- AI provider ----------------------------------------------------------
# mock    -> deterministic rule-based analyzer, no API key, works offline (default)
# openai  -> implemented by the AI teammate in app/services/ai/openai_provider.py
# anthropic -> ditto, anthropic_provider.py
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2

# --- Platform -------------------------------------------------------------
# true on serverless hosts (Vercel). Switches the DB to NullPool, because a
# per-instance connection pool exhausts Postgres there.
SERVERLESS=false

# --- Jobs -----------------------------------------------------------------
# inline  -> FastAPI BackgroundTask in this process (dev, Docker, Render...)
# worker  -> a separate `python -m app.services.jobs.worker` process
# request -> the client calls POST /audits/{id}/run, which does the work
#            inside that request. Required on serverless.
JOB_RUNNER=inline
JOB_MAX_ATTEMPTS=3
JOB_POLL_INTERVAL_SECONDS=2
